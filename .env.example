# Copy this file to `.env` and adjust values as needed.
#
# Backend endpoint that the enquiry forms POST to.
# Defaults to "/api/enquiries" (same origin) when not set.
VITE_API_ENDPOINT=/api/enquiries

# (Optional) Used only by the Vite dev server proxy in vite.config.js.
# Point this at your running backend for local development, e.g.
#   VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000
